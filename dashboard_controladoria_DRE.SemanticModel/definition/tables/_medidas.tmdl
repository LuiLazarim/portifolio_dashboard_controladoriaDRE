	measure 'Titulo analise temporal' =
			
			VAR vContaDRE = SELECTEDVALUE(dEstruturaDRE[contaGerencial])
			VAR vContaN1 = SELECTEDVALUE(dPlanoConta[descricaoN1])
			VAR vContaN2 = SELECTEDVALUE(dPlanoConta[descricaoN2])
			RETURN
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(vContaN2), vContaN2,
			    NOT ISBLANK(vContaN1), vContaN1,
			    NOT ISBLANK(vContaDRE), vContaDRE,
			    "= RESULTADO LÍQUIDO DO EXERCÍCIO"
			)
		displayFolder: Storytelling
		lineageTag: cc70b6c7-1540-4342-bf09-f288ffe643e8

	measure 'Subtitulo analise temporal' =
			
			VAR vMesesNegativos =
			CALCULATE(
			    COUNTROWS(
			        FILTER(
			            ALL(dCalendario[MesAno]),
			            [% Meta vs Realizado] < 0
			        )
			    ),
			    ALL(dCalendario),
			    VALUES(dCalendario[Ano])
			)
			VAR vMesesPositivos =
			CALCULATE(
			    COUNTROWS(
			        FILTER(
			            ALL(dCalendario[MesAno]),
			            [% Meta vs Realizado] >= 0 && NOT(ISBLANK([% Meta vs Realizado]))
			        )
			    ),
			    ALL(dCalendario),
			    VALUES(dCalendario[Ano])
			)
			VAR vAno = SELECTEDVALUE(dCalendario[Ano])
			RETURN
			"Em " &
			vAno &
			" batemos a meta em " &
			vMesesPositivos &
			" meses e ficamos abaixo do " &
			VALUES(auxMeta[auxMeta]) &
			" em " &
			vMesesNegativos &
			" meses:"
		displayFolder: Storytelling
		lineageTag: 8c1ee51c-ec5c-4a14-ac51-358bd668960c

	measure 'Subtitulo Analise Temporal Meta' = ```
			
			VAR vPiorMes =
			CALCULATE(
			    TOPN(
			        1,
			        FILTER(
			            VALUES(dCalendario[MesAno]),
			            NOT(ISBLANK([$ Realizado]))
			        ),
			        [% Meta vs Realizado],
			        ASC
			    ),
			    ALL(dCalendario),
			    VALUES(dCalendario[Ano])
			)
			VAR vValorPiorMes = 
			CALCULATE(
			    [% Meta vs Realizado],
			    dCalendario[MesAno] = vPiorMes
			)
			RETURN
			"... onde o pior mês foi " &
			vPiorMes &
			", comuma diferença de " &
			FORMAT(vValorPiorMes, "0.0%") &
			" em relação ao " &
			VALUES(auxMeta[auxMeta]) &
			":"
			```
		displayFolder: Storytelling
		lineageTag: b9358014-8a8e-4da5-8788-a4b820e4ec96

	measure 'Subtitulo Analise Temporal Acumulado' = ```
			
			VAR vRealizado = FORMAT([$ Realizado YDT], "R$ 0,0")
			VAR vDif = FORMAT([% Meta vs Realizado YDT], "0.0%;0.0%")
			VAR vAno = SELECTEDVALUE(dCalendario[Ano])
			VAR vResultadoDif = 
			SWITCH(
			    TRUE(),
			    [% Meta vs Realizado YDT] > 0, " acima do ",
			    [% Meta vs Realizado YDT] = 0, " igual ao ",
			    [% Meta vs Realizado YDT] < 0, " abaixo do ",
			    BLANK()
			)
			RETURN
			"No acumulado de " &
			vAno &
			" o Realizado foi de " &
			vRealizado &
			" (" &
			vDif &
			vResultadoDif &
			VALUES(auxMeta[auxMeta]) &
			"):"
			```
		displayFolder: Storytelling
		lineageTag: bf166ed6-8b96-4813-9eaa-95097408a61d

	partition _medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

