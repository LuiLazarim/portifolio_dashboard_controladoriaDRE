	measure 'Título Página' = ```
			
			VAR vFilial =
			CONCATENATEX(
			    VALUES(dEstruturaDRE[empresa]),
			    dEstruturaDRE[empresa],
			    ", "
			)
			VAR vMesAno = SELECTEDVALUE(dCalendario[MesAno])
			RETURN
			"Realizado vs " &
			VALUES(auxMeta[auxMeta]) &
			" para " &
			vFilial &
			" em " &
			vMesAno
			
			```
